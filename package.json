{
  "name": "ogalerie-api",
  "version": "1.0.0",
  "description": "API du projet d'apothéose O'Galerie",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "test": "vitest watch --reporter verbose",
    "build": "tsc",
    "start": "node ./dist/app.js",
    "dev": "DEBUG=errorHandler,controller,datamapper,service* tsx src/app.ts",
    "dev:watch": "DEBUG=errorHandler,controller,datamapper,service* tsx watch src/app.ts",
    "lint": "eslint ./src --ext .js,.ts",
    "lint:fix": "eslint ./src --ext .js,.ts --fix",
    "typecheck": "tsc --noEmit",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes"
  },
  "keywords": [],
  "author": "Arnaud Pithon",
  "license": "MIT",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^16.3.0",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "debug": "^4.4.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0"
  }
}
