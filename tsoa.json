{
  "entryFile": "src/app.ts",
  "controllerPathGlobs": [
    "src/modules/**/controller.ts"
  ],
  "spec": {
    "outputDirectory": "build",
    "specVersion": 3,
    "basePath": "/api"
  },
  "noImplicitAdditionalProperties": "throw-on-extras",
  "routes": {
    "routesDir": "src/routes"
  },
  "modelPathGlobs": [
    "src/types/**/*.ts"
  ]
}
